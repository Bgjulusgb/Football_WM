# RedditOrakel v3.7 — keep secrets, DBs, logs and runtime artifacts out of VCS.

# venvs / node_modules
backend/.venv/
frontend/node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# SQLite + WAL/SHM
*.db
*.db-shm
*.db-wal

# Logs
*.log
backend/uvicorn.log
backend/test_log_*.log

# ML / runtime artifacts (regenerate on demand)
backend/models_ml/artifacts/*.json
backend/models_ml/artifacts/*.txt
backend/models_ml/artifacts/*.yaml
backend/models_ml/artifacts/*.npy

# Env / secrets
.env
.env.local
.env.*.local
backend/.env

# Frontend build output
frontend/dist/
frontend/.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*~

# Local history snapshots
.history/

# Test/coverage output
coverage/
.coverage
htmlcov/
