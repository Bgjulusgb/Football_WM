# ══════════════════════════════════════════════════════════════════════════════
# RedditOrakel v3.3 — WM2026 18-Faktor-Ensemble Konfiguration
# ══════════════════════════════════════════════════════════════════════════════

# ── Reddit API (leer = Mock-Crawler) ─────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RedditOrakel/2.0 by /u/YourUsername
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── Datenbank ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./redditorakel.db

# ── Feature-Flags ────────────────────────────────────────────────────────────
USE_MOCK_CRAWLER=false
# USE_ARCTIC_SHIFT=true → Reddit-Daten kommen aus Arctic Shift (Pushshift-Mirror)
# parallel zu Reddits eigener JSON-API. Notwendig, weil www.reddit.com Scraping-IPs
# 2026 aggressiv mit 403 blockt. Arctic Shift hat keine API-Keys, kein Rate-Limit
# fuer normale Volumes und liefert dieselben Felder (Score, Comments, Timestamp).
USE_ARCTIC_SHIFT=true
USE_ROBERTA=false

# ── v3 Multi-Faktor-Engine ───────────────────────────────────────────────────
USE_FACTOR_ENSEMBLE=true

# Tor-Modell: "poisson" (Dixon-Coles), "negbin" (Negative-Binomial),
#             "glm_poisson" (statsmodels GLM mit Team-Festeffekten)
GOAL_MODEL=poisson
NEGBIN_SIZE=8.0

# ── Datenquellen-Toggles (false = Live-First, true = Offline-Mock) ───────────
USE_MOCK_OPENFOOTBALL=false
USE_MOCK_THESPORTSDB=false
USE_MOCK_OPENLIGADB=false
USE_MOCK_WIKIDATA=true
USE_MOCK_WEATHER=false
USE_MOCK_RSS=false
USE_MOCK_CLUBELO=false
USE_MOCK_FOOTBALL_DATA=false

# v3.3 — Neue Scraper (true = Mock, false = Live)
USE_MOCK_FBREF=false
USE_MOCK_UNDERSTAT=false
USE_MOCK_FOTMOB=false
USE_MOCK_SOFASCORE=false
USE_MOCK_TRANSFERMARKT=false

# v3.3 — Transfermarkt Politeness (HTML-Scraper)
TRANSFERMARKT_REQUEST_GAP_S=1.5
TRANSFERMARKT_CONCURRENCY=2

# ── API-Keys ─────────────────────────────────────────────────────────────────
ODDS_API_KEY=ca53c87b0e378f210078778815e3196d
ENABLE_ODDS_INTEGRATION=false
FOOTBALL_DATA_API_KEY=65e47195588947ccb4539f21992c5c83

# Admin-Panel Zugangsschluessel (selbst gewaehlt, fuer /api/admin/*)
ADMIN_API_KEY=redditorakel-admin-2026

# ── NVIDIA LLM (build.nvidia.com) ───────────────────────────────────────────
NVIDIA_API_KEY=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
USE_NVIDIA_LLM=true
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MAX_POSTS_PER_TIER=6
LLM_REQUEST_BUDGET_PER_MATCH=3
LLM_TEMPERATURE=0.1

# ── Faktor-Gewichte (Ensemble re-normalisiert auf Summe 1) ──────────────────
# Basis-Faktoren (v3.0)
FACTOR_WEIGHT_ELO=0.30
FACTOR_WEIGHT_FORM=0.20
FACTOR_WEIGHT_H2H=0.15
FACTOR_WEIGHT_GOALS=0.15
FACTOR_WEIGHT_CONTEXT=0.10
FACTOR_WEIGHT_SENTIMENT=0.10
FACTOR_WEIGHT_SQUAD=0.05

# Erweiterte Faktoren (v3.2)
FACTOR_WEIGHT_FIFA_RANK=0.05
FACTOR_WEIGHT_REST_TRAVEL=0.06
FACTOR_WEIGHT_ALTITUDE=0.05
FACTOR_WEIGHT_MARKET=0.10
FACTOR_WEIGHT_WEATHER=0.04
FACTOR_WEIGHT_INJURY=0.06
FACTOR_WEIGHT_MOMENTUM=0.05
FACTOR_WEIGHT_ML=0.00
# v3.3 — Neue Faktoren (> 0 = aktiv)
FACTOR_WEIGHT_ML_LGBM=0.00
FACTOR_WEIGHT_LLM_SENTIMENT=0.08
FACTOR_WEIGHT_LINEUP=0.05
FACTOR_WEIGHT_SQUAD_VALUE=0.04
FACTOR_WEIGHT_NETWORK=0.05

# ── Orchestrierung ───────────────────────────────────────────────────────────
# Prefect DAG statt APScheduler (optional)
USE_PREFECT=false
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_HOURS=6

# ── Server ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
RATE_LIMIT_GET_PER_MINUTE=60
RATE_LIMIT_POST_PER_MINUTE=5

# ── Cache ────────────────────────────────────────────────────────────────────
DATASOURCE_CACHE_TTL_HOURS=6
DATASOURCE_HTTP_TIMEOUT_S=15.0
DATASOURCE_RETRY_ATTEMPTS=3
DATASOURCE_RETRY_BACKOFF_S=1.5
CACHE_MATCH_LIST_TTL_S=60
CACHE_PREDICTION_TTL_S=300
