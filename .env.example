# ══════════════════════════════════════════════════════════════════════════════
# WM 2026 — Match-Analyse & Prediction · Beispiel-Konfiguration
# ──────────────────────────────────────────────────────────────────────────────
# Kopiere diese Datei nach `.env` und passe die Werte an:
#     cp .env.example .env
#
# LIVE-MODUS ist der Standard: alle USE_MOCK_* stehen auf false.
# Quellen ohne API-Key degradieren automatisch auf Mock, wenn die Verbindung
# fehlschlägt — die Pipeline läuft immer durch.
#
# Für reinen Offline-/CI-Betrieb alle USE_MOCK_* auf true setzen:
#     python -m wm2026.cli predict --mode mock --match config/matches/...
#
# NIEMALS die echte .env committen — sie steht in .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── Reddit (Sentiment-Layer) ─────────────────────────────────────────────────
# KEIN Account/Key nötig: der Crawler liest den öffentlichen JSON-Endpunkt
# old.reddit.com/r/<sub>/.json (höflich gedrosselt, Backoff, Circuit-Breaker).
# Die OAuth-Felder unten bleiben nur für eine optionale authentifizierte
# Variante — leer lassen ist der Normalfall.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wm2026/1.0
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── Datenbank ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./wm2026.db

# ── Zielmodell ────────────────────────────────────────────────────────────────
# "poisson" (Dixon-Coles) | "negbin" (Negative-Binomial) | "glm_poisson" (GLM)
GOAL_MODEL=poisson
NEGBIN_SIZE=8.0
# "blend" = gewichtetes Mittel aller 3 Modelle (Standard) | "primary" = nur GOAL_MODEL
GOAL_MODEL_COMBINE=blend
BOOTSTRAP_N=500
BOOTSTRAP_XG_SIGMA=0.15

# ── Data-Source-Toggles ── false = LIVE, true = Mock (Offline) ───────────────
# Standard: LIVE. Einzelne Quellen auf true setzen um sie zu deaktivieren.
# Jede Quelle degradiert automatisch auf Mock bei Verbindungsfehler.
USE_MOCK_CRAWLER=false
USE_MOCK_OPENFOOTBALL=false
USE_MOCK_THESPORTSDB=false
USE_MOCK_OPENLIGADB=false
USE_MOCK_WIKIDATA=false
USE_MOCK_WEATHER=false
USE_MOCK_RSS=false
USE_MOCK_CLUBELO=false
USE_MOCK_FOOTBALL_DATA=false
USE_MOCK_FBREF=false
USE_MOCK_UNDERSTAT=false
USE_MOCK_FOTMOB=false
USE_MOCK_SOFASCORE=false
USE_MOCK_TRANSFERMARKT=false
USE_ARCTIC_SHIFT=false
USE_ROBERTA=false

# ── Transfermarkt Crawler-Politeness (nur wenn USE_MOCK_TRANSFERMARKT=false) ──
TRANSFERMARKT_REQUEST_GAP_S=1.5
TRANSFERMARKT_CONCURRENCY=2

# ── API-Keys (optional; nur für die jeweilige Live-Quelle nötig) ──────────────

# football-data.org — kostenloser Free-Tier (WC-Spielplan, ~10 req/min):
#   Registrierung: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# The-Odds-API — Live-Quoten (optional):
#   https://the-odds-api.com/
ODDS_API_KEY=
ENABLE_ODDS_INTEGRATION=false

# ADMIN_API_KEY — Passwort für das Admin-Panel (/api/admin/*).
# ─────────────────────────────────────────────────────────────
# Wenn gesetzt: jede Admin-API-Anfrage muss den Header X-API-Key: <wert> haben.
# Leer lassen → Admin-Endpunkte ohne Authentifizierung (nur lokal empfohlen).
# Selbst gewählter Wert, z.B.: ADMIN_API_KEY=mein-geheimes-passwort
ADMIN_API_KEY=

# ── NVIDIA LLM Aspekt-Sentiment ──────────────────────────────────────────────
# Key: https://build.nvidia.com/ — Standard ist AN; ohne Key bleibt der Scorer
# stumm (available-Gate prüft Key UND Flag), Mock-Mode schaltet ihn hart ab.
NVIDIA_API_KEY=
USE_NVIDIA_LLM=true
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MAX_POSTS_PER_TIER=6
LLM_REQUEST_BUDGET_PER_MATCH=3
LLM_TEMPERATURE=0.1

# ── Faktor-Gewichte (Ensemble normalisiert automatisch) ───────────────────────
# Core (v3.0)
FACTOR_WEIGHT_ELO=0.30
FACTOR_WEIGHT_FORM=0.20
FACTOR_WEIGHT_H2H=0.15
FACTOR_WEIGHT_GOALS=0.15
FACTOR_WEIGHT_CONTEXT=0.10
FACTOR_WEIGHT_SENTIMENT=0.10
FACTOR_WEIGHT_SQUAD=0.05
# Extended (v3.2)
FACTOR_WEIGHT_FIFA_RANK=0.05
FACTOR_WEIGHT_REST_TRAVEL=0.06
FACTOR_WEIGHT_ALTITUDE=0.05
FACTOR_WEIGHT_MARKET=0.10
FACTOR_WEIGHT_WEATHER=0.04
FACTOR_WEIGHT_INJURY=0.06
FACTOR_WEIGHT_MOMENTUM=0.05
# Inaktive Köpfe — Gewicht > 0 setzen zum Aktivieren
FACTOR_WEIGHT_ML=0.00
FACTOR_WEIGHT_ML_LGBM=0.00
# LLM-Sentiment läuft live mit (NVIDIA-Key + Reddit-Text); ohne beides
# meldet der Faktor available=false und renormalisiert sich raus.
FACTOR_WEIGHT_LLM_SENTIMENT=0.05
FACTOR_WEIGHT_LINEUP=0.00
FACTOR_WEIGHT_SQUAD_VALUE=0.00
FACTOR_WEIGHT_NETWORK=0.00

# ── Connector-Parameter ───────────────────────────────────────────────────────
DATASOURCE_CACHE_TTL_HOURS=6
DATASOURCE_HTTP_TIMEOUT_S=15.0
DATASOURCE_RETRY_ATTEMPTS=3
DATASOURCE_RETRY_BACKOFF_S=1.5

# ── Sonstiges ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
USE_PREFECT=false
ENABLE_SCHEDULER=false
