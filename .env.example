# ══════════════════════════════════════════════════════════════════════════════
# WM 2026 — Match-Analyse & Prediction · example configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in keys ONLY if you want live data:
#     cp .env.example .env
# The defaults below are OFFLINE-FIRST: every data source is mocked, so
#     python -m wm2026.cli predict --match config/matches/group_a/cze_vs_rsa.yaml
# runs with no API keys and no network access. NEVER commit a real .env.
# ══════════════════════════════════════════════════════════════════════════════

# ── Reddit API (sentiment layer; leave empty for mock) ────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wm2026/1.0
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── Database (only used by the optional persistent cache / full app) ──────────
DATABASE_URL=sqlite+aiosqlite:///./wm2026.db

# ── Goal model ────────────────────────────────────────────────────────────────
# "poisson" (Dixon-Coles) | "negbin" (Negative-Binomial) | "glm_poisson" (GLM)
GOAL_MODEL=poisson
NEGBIN_SIZE=8.0
# "blend" = weighted mean of all 3 models (default) | "primary" = GOAL_MODEL only
GOAL_MODEL_COMBINE=blend
BOOTSTRAP_N=500
BOOTSTRAP_XG_SIGMA=0.15

# ── Data-source toggles — true = MOCK (offline), false = LIVE ─────────────────
USE_MOCK_CRAWLER=true
USE_MOCK_OPENFOOTBALL=true
USE_MOCK_THESPORTSDB=true
USE_MOCK_OPENLIGADB=true
USE_MOCK_WIKIDATA=true
USE_MOCK_WEATHER=true
USE_MOCK_RSS=true
USE_MOCK_CLUBELO=true
USE_MOCK_FOOTBALL_DATA=true
USE_MOCK_FBREF=true
USE_MOCK_UNDERSTAT=true
USE_MOCK_FOTMOB=true
USE_MOCK_SOFASCORE=true
USE_MOCK_TRANSFERMARKT=true
USE_ARCTIC_SHIFT=false
USE_ROBERTA=false

# ── Transfermarkt politeness (only when USE_MOCK_TRANSFERMARKT=false) ──────────
TRANSFERMARKT_REQUEST_GAP_S=1.5
TRANSFERMARKT_CONCURRENCY=2

# ── API keys (optional; needed only for the matching live source) ─────────────
ODDS_API_KEY=
ENABLE_ODDS_INTEGRATION=false
FOOTBALL_DATA_API_KEY=
ADMIN_API_KEY=

# ── NVIDIA LLM aspect-sentiment (build.nvidia.com, OpenAI-compatible) ─────────
NVIDIA_API_KEY=
USE_NVIDIA_LLM=false
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MAX_POSTS_PER_TIER=6
LLM_REQUEST_BUDGET_PER_MATCH=3
LLM_TEMPERATURE=0.1

# ── Factor weights (the ensemble re-normalises whatever is available) ─────────
# Core (v3.0)
FACTOR_WEIGHT_ELO=0.30
FACTOR_WEIGHT_FORM=0.20
FACTOR_WEIGHT_H2H=0.15
FACTOR_WEIGHT_GOALS=0.15
FACTOR_WEIGHT_CONTEXT=0.10
FACTOR_WEIGHT_SENTIMENT=0.10
FACTOR_WEIGHT_SQUAD=0.05
# Extended (v3.2)
FACTOR_WEIGHT_FIFA_RANK=0.05
FACTOR_WEIGHT_REST_TRAVEL=0.06
FACTOR_WEIGHT_ALTITUDE=0.05
FACTOR_WEIGHT_MARKET=0.10
FACTOR_WEIGHT_WEATHER=0.04
FACTOR_WEIGHT_INJURY=0.06
FACTOR_WEIGHT_MOMENTUM=0.05
# Dormant heads — activate by raising the weight above 0
FACTOR_WEIGHT_ML=0.00
FACTOR_WEIGHT_ML_LGBM=0.00
FACTOR_WEIGHT_LLM_SENTIMENT=0.00
FACTOR_WEIGHT_LINEUP=0.00
FACTOR_WEIGHT_SQUAD_VALUE=0.00
FACTOR_WEIGHT_NETWORK=0.00

# ── Connector knobs ───────────────────────────────────────────────────────────
DATASOURCE_CACHE_TTL_HOURS=6
DATASOURCE_HTTP_TIMEOUT_S=15.0
DATASOURCE_RETRY_ATTEMPTS=3
DATASOURCE_RETRY_BACKOFF_S=1.5

# ── Misc / full-app only ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
USE_PREFECT=false
ENABLE_SCHEDULER=false
